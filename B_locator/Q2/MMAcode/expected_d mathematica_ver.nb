        "\[IndentingNewLine]", 
        RowBox[{"diff", "=", 
         RowBox[{"P2", "-", "P1"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"denom", "=", 
         RowBox[{
          RowBox[{
           RowBox[{"u1", "[", 
